{
  "name": "mustaaaaaard-27",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*"]
  },
  "observability": { "enabled": false }
}
