# Compose input: docker compose reads root .env via env_file; do not use for native startup.
ENVIRONMENT=development
DEV_AUTH=true
SECRET_KEY=development-only-change-this-secret-key
DATABASE_URL=postgresql+psycopg://mustard:mustard@localhost:5432/mustard
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://localhost:9000
# Optional externally reachable hostname for signing; never rewrite signed URLs.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mustard-local
S3_SECRET_KEY=mustard-local-password
S3_BUCKET=mustard-private
S3_REGION=us-east-1
MEDIA_URL_SECONDS=120
CAPTURE_SECONDS=600
GROUP_RATE=5
FFMPEG=ffmpeg
FFPROBE=ffprobe
