# Native backend configuration, loaded explicitly from backend/.env by Settings.
# Process environment variables take precedence. Root .env is not read by native Python.
ENVIRONMENT=development
DEV_AUTH=true
SECRET_KEY=development-only-change-this-secret-key
DATABASE_URL=postgresql+psycopg://mustard:mustard@localhost:5432/mustard
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://localhost:9000
# Optional externally reachable hostname for signing; never rewrite signed URLs.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mustard-local
S3_SECRET_KEY=mustard-local-password
S3_BUCKET=mustard-private
S3_REGION=us-east-1
MEDIA_URL_SECONDS=120
CAPTURE_SECONDS=600
GROUP_RATE=5
MEDIA_CONCURRENCY=1
FFMPEG_THREADS=1
FFMPEG_PRESET=veryfast
# Zero disables a quota for existing native development. Production free profile
# uses 8,000,000,000 bytes and 10,000 objects, shared across all groups.
STORAGE_QUOTA_BYTES=0
STORAGE_OBJECT_QUOTA=0
# R2 free allowances are NOT a hard billing cap. Set true only after approval.
R2_BILLING_ACKNOWLEDGED=false
FFMPEG=ffmpeg
FFPROBE=ffprobe
