# Reference only: enter values in Render Environment or a private local env file.
# Never commit a populated copy. Do not put any of these secrets in VITE_*.
ENVIRONMENT=production
DEV_AUTH=false
COOKIE_SECURE=true
BASE_URL=https://YOUR-ALLOCATED-SERVICE.onrender.com
ALLOWED_ORIGINS=["https://YOUR-ALLOCATED-SERVICE.onrender.com"]
SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@NEON-DIRECT-HOST/DB?sslmode=require&channel_binding=require
GOOGLE_CLIENT_ID=REPLACE_IN_SECRET_MANAGER
GOOGLE_CLIENT_SECRET=REPLACE_IN_SECRET_MANAGER
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mustaaaaaard-production
S3_ACCESS_KEY=REPLACE_IN_SECRET_MANAGER
S3_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
MEDIA_URL_SECONDS=120
MEDIA_CONCURRENCY=1
FFMPEG_THREADS=1
STORAGE_QUOTA_BYTES=8000000000
STORAGE_OBJECT_QUOTA=10000
R2_BILLING_ACKNOWLEDGED=false
RUN_RELEASE_ON_START=true
CLEANUP_WHILE_AWAKE=true
